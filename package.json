    "design:render": "make design-render"
  },
  "prettier": "@sosed/config/prettier",
  "devDependencies": {
    "@sosed/config": "workspace:*",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "7.0.2"
  }
}
