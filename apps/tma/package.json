{
  "name": "@sosed/tma",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram Mini App «Соседи»: Vite + React, экраны по утверждённому макету",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "stand": "vite build && vite preview --port 5173 --strictPort",
    "e2e:build": "VITE_TELEGRAM_BOT=sosed_e2e_bot VITE_SENTRY_DSN= VITE_MAP_ASSETS_URL= vite build",
    "e2e": "playwright test",
    "size": "node scripts/size.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@protomaps/basemaps": "5.7.2",
    "@sentry/react": "10.76.2",
    "@sosed/api-client": "workspace:*",
    "@sosed/design-tokens": "workspace:*",
    "@sosed/domain": "workspace:*",
    "@sosed/hooks": "workspace:*",
    "@sosed/i18n": "workspace:*",
    "@sosed/links": "workspace:*",
    "@sosed/platform": "workspace:*",
    "@sosed/ui-web": "workspace:*",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-virtual": "3.14.14",
    "maplibre-gl": "6.13.0",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@sosed/config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
