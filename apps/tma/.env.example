# apps/tma/.env — настройки dev-сервера и сборки Mini App. Секретов здесь нет: всё с VITE_ попадает в бандл.
# Хосты туннеля для dev-сервера через cloudflared (0.22), через запятую
TMA_ALLOWED_HOSTS=
# CDN медиа для CSP img-src (0.24, 2.2), через запятую
VITE_MEDIA_ORIGINS=
# S3 API хранилища для CSP connect-src/img-src (presigned PUT и GET, 0.24): R2 или туннель Garage (make tunnel)
TMA_STORAGE_ORIGINS=
# Sentry фронта; пусто — выключен (SDK не загружается). Адрес приёма из DSN сборка добавляет в CSP connect-src
VITE_SENTRY_DSN=
# Бот Mini App без @ — ссылки t.me/<бот>?startapp=… на страницах браузерной оболочки (8.1); пусто — без ссылки
VITE_TELEGRAM_BOT=
