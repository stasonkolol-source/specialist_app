# Секреты stage для Kamal (DEVELOPMENT_PLAN 0.25c). Q1 по умолчанию — (б): значения живут в секретах
# GitHub environment «stage» (только main), в git — только имена. Kamal читает этот файл как dotenv с
# подстановкой из окружения: в CI их кладёт job с environment: stage (.github/workflows/deploy.yml),
# у владельца — менеджер паролей (Q15). Пустая переменная — пустой секрет: необязательные (AI) так
# и выключаются. Значения не печатать: никаких kamal secrets print (OWNER_CHECKLIST, правило 3).

# GHCR: логин — github.actor, пароль — GITHUB_TOKEN job'а (K16: PAT не нужен, пока деплой из CI)
KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Сертификат Origin CA для kamal-proxy (Terraform, K12) — PEM целиком
KAMAL_PROXY_SSL_CERT=$KAMAL_PROXY_SSL_CERT
KAMAL_PROXY_SSL_KEY=$KAMAL_PROXY_SSL_KEY

# PostgreSQL: суперпользователь и роли (make gen-secret; только [A-Za-z0-9_-] — они идут в DSN)
POSTGRES_SUPERUSER_PASSWORD=$POSTGRES_SUPERUSER_PASSWORD
APP_DB_PASSWORD=$APP_DB_PASSWORD
MIGRATOR_DB_PASSWORD=$MIGRATOR_DB_PASSWORD
READONLY_DB_PASSWORD=$READONLY_DB_PASSWORD
BACKUP_DB_PASSWORD=$BACKUP_DB_PASSWORD
DB_DSN=postgresql+psycopg://app:${APP_DB_PASSWORD}@sosed-postgres:5432/specialist
DB_MIGRATOR_DSN=postgresql+psycopg://migrator:${MIGRATOR_DB_PASSWORD}@sosed-postgres:5432/specialist

# Приложение
TELEGRAM_BOT_TOKEN=$TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=$TELEGRAM_WEBHOOK_SECRET
JWT_KEYS=$JWT_KEYS
APP_HASH_KEY=$APP_HASH_KEY
S3_ACCESS_KEY_ID=$S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY
AI_OPENAI_API_KEY=$AI_OPENAI_API_KEY
AI_ANTHROPIC_API_KEY=$AI_ANTHROPIC_API_KEY
