# Секреты production для Kamal (DEVELOPMENT_PLAN 3.1b–3.1c). Q1 по умолчанию — (б): значения живут в
# секретах GitHub environment «production» (только main, ручной запуск с подтверждением), в git — только
# имена. Kamal читает этот файл как dotenv с подстановкой из окружения: в CI их кладёт job deploy-production
# (.github/workflows/deploy.yml). Значения не печатать: никаких kamal secrets print (правило 3).

# GHCR: логин — github.actor, пароль — GITHUB_TOKEN job'а (K16)
KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Сертификат Origin CA prod (api. и admin.) для kamal-proxy — infra/terraform/prod, PEM целиком
KAMAL_PROXY_SSL_CERT=$KAMAL_PROXY_SSL_CERT
KAMAL_PROXY_SSL_KEY=$KAMAL_PROXY_SSL_KEY

# PostgreSQL на db-1 (provision.sh): пароли ролей, только [A-Za-z0-9_-] — они идут в DSN. Пароля
# суперпользователя нет: postgres входит только локально на db-1 (peer). TLS приватной сети —
# sslmode=require; PROD_DB_IP — адрес db-1 в приватной сети (Variables).
APP_DB_PASSWORD=$APP_DB_PASSWORD
MIGRATOR_DB_PASSWORD=$MIGRATOR_DB_PASSWORD
READONLY_DB_PASSWORD=$READONLY_DB_PASSWORD
BACKUP_DB_PASSWORD=$BACKUP_DB_PASSWORD
MONITORING_DB_PASSWORD=$MONITORING_DB_PASSWORD
DB_DSN=postgresql+psycopg://app:${APP_DB_PASSWORD}@${PROD_DB_IP}:5432/specialist?sslmode=require
DB_MIGRATOR_DSN=postgresql+psycopg://migrator:${MIGRATOR_DB_PASSWORD}@${PROD_DB_IP}:5432/specialist?sslmode=require

# Приложение
TELEGRAM_BOT_TOKEN=$TELEGRAM_BOT_TOKEN
TELEGRAM_WEBHOOK_SECRET=$TELEGRAM_WEBHOOK_SECRET
JWT_KEYS=$JWT_KEYS
APP_HASH_KEY=$APP_HASH_KEY
APP_ADMIN_SESSION_KEY=$APP_ADMIN_SESSION_KEY
# шифрование секретов TOTP персонала (8.4); PREVIOUS — только на время ротации, иначе пусто
APP_TOTP_KEY=$APP_TOTP_KEY
APP_TOTP_KEY_PREVIOUS=$APP_TOTP_KEY_PREVIOUS
S3_ACCESS_KEY_ID=$S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY
AI_OPENAI_API_KEY=$AI_OPENAI_API_KEY
AI_ANTHROPIC_API_KEY=$AI_ANTHROPIC_API_KEY

# Наблюдаемость (3.3): ping URL heartbeat воркера в Healthchecks (K33); токен Grafana Cloud с
# metrics:write и logs:write (K35); DSN роли monitoring для postgres_exporter в Alloy (только pg_monitor)
HEALTHCHECKS_WORKER_PING_URL=$HEALTHCHECKS_WORKER_PING_URL
GRAFANA_CLOUD_TOKEN=$GRAFANA_CLOUD_TOKEN
PG_MONITOR_DSN=postgresql://monitoring:${MONITORING_DB_PASSWORD}@${PROD_DB_IP}:5432/specialist?sslmode=require
