# infra/monitoring/.env — ключи «как кода» наблюдаемости (3.3, K35) для make monitoring-rules и
# make monitoring-dashboards. Значения вписывает только владелец: make secret NAME=… TARGET=monitoring;
# проверка — make secrets-check. На серверы эти ключи не попадают.

# ruler Grafana Cloud (mimirtool): адрес Prometheus стека без пути, его user id и токен access policy
# со scope rules:read и rules:write
MIMIR_ADDRESS=
MIMIR_TENANT_ID=
MIMIR_API_KEY=
# Grafana стека (https://<стек>.grafana.net) и токен service account с ролью Editor
GRAFANA_URL=
GRAFANA_SA_TOKEN=
