# Образец: cp prod.tfvars.example terraform.tfvars и заполнить. Секретов здесь нет (токены — в .env),
# terraform.tfvars можно коммитить.

# 3.1a — Hetzner (K38)
app_server_type = "cx33" # итог 0.26
db_server_type  = "cx33"
location        = "nbg1" # Q12
ssh_public_keys = {
  owner  = "ssh-ed25519 AAAA… owner"       # K15: cat ~/.ssh/id_ed25519.pub
  deploy = "ssh-ed25519 AAAA… deploy-prod" # K15: deploy-ключ prod — не тот, что у stage
}
# Q13: по умолчанию 22-й порт app-1 открыт всем, вход только по ключу; db-1 — только через app-1
# ssh_allowed_cidrs = ["0.0.0.0/0", "::/0"]

# 3.1c — Cloudflare (после K11, K12, K39; Q8 — домен под название)
cloudflare_enabled    = false
domain                = "" # Q9
cloudflare_account_id = "" # K11
cloudflare_zone_id    = "" # K11

# 3.1c — после первого wrangler deploy Worker'а sosed-tma-production
mini_app_worker_deployed = false

# 3.1c — Access перед admin.<domain> (K31: организация Zero Trust, K30: e-mail персонала)
access_enabled = false
access_emails  = [] # ["owner@example.com"]
