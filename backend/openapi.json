{
  "openapi": "3.1.0",
  "info": {
    "title": "Сосед API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/telegram": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Authenticate Telegram",
        "description": "Обмен initData Mini App на собственную сессию.",
        "operationId": "identity_authenticate_telegram",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "tma <initData>",
              "title": "Authorization"
            },
            "description": "tma <initData>"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthOut"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка в формате RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Refresh Session",
        "description": "Новая пара токенов; старый refresh больше не действует.",
        "operationId": "identity_refresh_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokensOut"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка в формате RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Logout",
        "description": "Отозвать текущую сессию: refresh и выданные access перестают действовать.",
        "operationId": "identity_logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "default": {
            "description": "Ошибка в формате RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Get Me",
        "description": "Профиль, принятые версии документов и что можно делать (онбординг, S49b).",
        "operationId": "identity_get_me",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка в формате RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemOut"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "identity"
        ],
        "summary": "Update Me",
        "description": "Имя, язык, город и намерение. `If-Match: \"<version>\"` из ETag защищает от затирания.",
        "operationId": "identity_update_me",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-Match"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MeUpdateIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка в формате RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/consents": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Accept Consents",
        "description": "Одна галочка S02c: правила площадки (с 18+) и политика в версиях из client-config.\n\nПовтор идемпотентен; не та версия — 409 `legal_version_outdated`.",
        "operationId": "identity_accept_consents",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentsIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeOut"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка в формате RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemOut"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/cities": {
      "get": {
        "tags": [
          "geo"
        ],
        "summary": "List Cities",
        "description": "Города: активные и со статусом «скоро».",
        "operationId": "geo_list_cities",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CityOut"
                  },
                  "type": "array",
                  "title": "Response Geo List Cities"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка в формате RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cities/{city_id}/districts": {
      "get": {
        "tags": [
          "geo"
        ],
        "summary": "List Districts",
        "operationId": "geo_list_districts",
        "parameters": [
          {
            "name": "city_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 2147483647,
              "minimum": 1,
              "title": "City Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DistrictOut"
                  },
                  "title": "Response Geo List Districts"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка в формате RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/geo/resolve": {
      "get": {
        "tags": [
          "geo"
        ],
        "summary": "Resolve Point",
        "description": "Район точки: внутри полигона или ближайший центр района не дальше 15 км.",
        "operationId": "geo_resolve_point",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 90,
              "minimum": -90,
              "title": "Lat"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number",
              "maximum": 180,
              "minimum": -180,
              "title": "Lon"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResolveOut"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка в формате RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List Categories",
        "description": "Дерево категорий на языке Accept-Language; ETag + If-None-Match → 304.\n\nНеизвестный город — не ошибка: у категорий просто нет ориентира цены.",
        "operationId": "catalog_list_categories",
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "slug города для price_hint",
              "title": "City"
            },
            "description": "slug города для price_hint"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CategoryOut"
                  },
                  "title": "Response Catalog List Categories"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка в формате RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemOut"
                }
              }
            }
          },
          "304": {
            "description": "Не изменилось (If-None-Match)"
          }
        }
      }
    },
    "/api/v1/client-config": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Get Client Config",
        "operationId": "system_get_client_config",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientConfigOut"
                }
              }
            }
          },
          "default": {
            "description": "Ошибка в формате RFC 9457",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemOut"
                }
              }
            }
          },
          "304": {
            "description": "Не изменилось (If-None-Match)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthOut": {
        "properties": {
          "token_type": {
            "type": "string",
            "const": "Bearer",
            "title": "Token Type",
            "default": "Bearer"
          },
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "access_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Access Expires At"
          },
          "refresh_token": {
            "type": "string",
            "title": "Refresh Token"
          },
          "refresh_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Refresh Expires At"
          },
          "is_new": {
            "type": "boolean",
            "title": "Is New"
          },
          "user": {
            "$ref": "#/components/schemas/MeOut"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "access_expires_at",
          "refresh_token",
          "refresh_expires_at",
          "is_new",
          "user"
        ],
        "title": "AuthOut"
      },
      "CategoryOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "icon": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon"
          },
          "price_hint": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PriceHintOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "tags": {
            "items": {
              "$ref": "#/components/schemas/TagOut"
            },
            "type": "array",
            "title": "Tags"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/CategoryOut"
            },
            "type": "array",
            "title": "Children"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "icon",
          "price_hint",
          "tags",
          "children"
        ],
        "title": "CategoryOut"
      },
      "CityOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "$ref": "#/components/schemas/CityStatus"
          },
          "center": {
            "$ref": "#/components/schemas/PointOut"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "status",
          "center"
        ],
        "title": "CityOut"
      },
      "CityStatus": {
        "type": "string",
        "enum": [
          "active",
          "soon"
        ],
        "title": "CityStatus"
      },
      "ClientConfigOut": {
        "properties": {
          "min_versions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Min Versions"
          },
          "flags": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Flags"
          },
          "legal_versions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Legal Versions"
          }
        },
        "type": "object",
        "required": [
          "min_versions",
          "flags",
          "legal_versions"
        ],
        "title": "ClientConfigOut"
      },
      "ConsentsIn": {
        "properties": {
          "terms_version": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Terms Version"
          },
          "privacy_version": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Privacy Version"
          }
        },
        "type": "object",
        "required": [
          "terms_version",
          "privacy_version"
        ],
        "title": "ConsentsIn",
        "description": "Галочка S02c: версии правил (с 18+) и политики из client-config, которые видел\nпользователь."
      },
      "Currency": {
        "type": "string",
        "enum": [
          "RSD",
          "XTR"
        ],
        "title": "Currency"
      },
      "DistrictKind": {
        "type": "string",
        "enum": [
          "municipality",
          "neighborhood"
        ],
        "title": "DistrictKind"
      },
      "DistrictOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "$ref": "#/components/schemas/DistrictKind"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "center": {
            "$ref": "#/components/schemas/PointOut"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "name",
          "kind",
          "parent_id",
          "center"
        ],
        "title": "DistrictOut"
      },
      "DistrictRefOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug",
          "name"
        ],
        "title": "DistrictRefOut"
      },
      "FieldErrorOut": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "FieldErrorOut"
      },
      "Locale": {
        "type": "string",
        "enum": [
          "ru",
          "sr-Latn",
          "sr-Cyrl",
          "en"
        ],
        "title": "Locale"
      },
      "MeOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "ui_locale": {
            "$ref": "#/components/schemas/Locale"
          },
          "trust_level": {
            "type": "integer",
            "title": "Trust Level"
          },
          "phone_verified": {
            "type": "boolean",
            "title": "Phone Verified"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "home_city_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home City Id"
          },
          "intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserIntent"
              },
              {
                "type": "null"
              }
            ]
          },
          "consents": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Consents"
          },
          "consent_required": {
            "type": "boolean",
            "title": "Consent Required"
          },
          "can_post_jobs": {
            "type": "boolean",
            "title": "Can Post Jobs"
          },
          "can_respond": {
            "type": "boolean",
            "title": "Can Respond"
          },
          "can_message": {
            "type": "boolean",
            "title": "Can Message"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name",
          "ui_locale",
          "trust_level",
          "phone_verified",
          "created_at",
          "home_city_id",
          "intent",
          "consents",
          "consent_required",
          "can_post_jobs",
          "can_respond",
          "can_message"
        ],
        "title": "MeOut"
      },
      "MeUpdateIn": {
        "properties": {
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "ui_locale": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Locale"
              },
              {
                "type": "null"
              }
            ]
          },
          "home_city_id": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Home City Id"
          },
          "intent": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/UserIntent"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "MeUpdateIn",
        "description": "Поля, которых нет или которые null, не меняются."
      },
      "MoneyOut": {
        "properties": {
          "amount": {
            "type": "integer",
            "title": "Amount"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "currency"
        ],
        "title": "MoneyOut"
      },
      "PointOut": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "title": "Lon"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "title": "PointOut"
      },
      "PriceHintOut": {
        "properties": {
          "min": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "max": {
            "$ref": "#/components/schemas/MoneyOut"
          },
          "unit": {
            "$ref": "#/components/schemas/PriceUnit"
          }
        },
        "type": "object",
        "required": [
          "min",
          "max",
          "unit"
        ],
        "title": "PriceHintOut",
        "description": "«Обычно за это платят 1 000–2 400 RSD за час» (§7.7)."
      },
      "PriceUnit": {
        "type": "string",
        "enum": [
          "work",
          "hour",
          "m2",
