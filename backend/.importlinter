[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:module-layers]
name = Слои внутри модуля (ADR-0020 §1)
type = layers
containers =
    app.modules.*
layers =
    di
    (privacy)
    (http) | (bot) | (admin) | (tasks) | infrastructure
    application
    domain | api
    errors
ignore_imports =
    # SQLAdmin, только справочники (ADR-0020 §1)
    app.modules.*.admin.views -> app.modules.*.infrastructure.models
unmatched_ignore_imports_alerting = none

[importlinter:contract:pure-core]
name = domain, application и контракты без фреймворков (ADR-0020 §1)
type = forbidden
source_modules =
    app.modules.*.domain
    app.modules.*.application
    app.modules.*.api
    app.modules.*.errors
    app.platform.kernel
    app.platform.contracts
    app.platform.text
    app.platform.*.port
forbidden_modules =
    sqlalchemy
    geoalchemy2
    psycopg
    fastapi
    starlette
    sqladmin
    aiogram
    aiohttp
    procrastinate
    redis
    valkey
    boto3
    botocore
    aiobotocore
    httpx
    openai
    anthropic
    jwt
    sentry_sdk
    pydantic
    pydantic_settings
    dishka

[importlinter:contract:module-dag]
name = Граф зависимостей модулей (ARCHITECTURE §5.4, ADR-0002)
type = layers
layers =
    app.entrypoints
    app.interfaces
    app.modules.moderation | app.modules.notifications | app.modules.search | app.modules.growth
    app.modules.messaging | app.modules.reviews
    app.modules.jobs
    app.modules.deals | app.modules.pricing
    app.modules.specialists
    app.modules.media | app.modules.billing
    app.modules.identity
    app.modules.geo | app.modules.catalog
    app.platform

[importlinter:contract:interfaces-independent]
name = Интерфейсы процессов не импортируют друг друга (ADR-0020 §7)
type = independence
modules =
    app.interfaces.http
    app.interfaces.bot
    app.interfaces.worker
    app.interfaces.admin

[importlinter:contract:only-api-identity]
name = Снаружи модуля identity виден только api (ADR-0002)
type = protected
protected_modules =
    app.modules.identity.domain
    app.modules.identity.application
    app.modules.identity.infrastructure
    app.modules.identity.errors
    app.modules.identity.di
allowed_importers =
    app.modules.identity
    app.entrypoints

