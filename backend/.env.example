# backend/.env — настройки процессов. Значения не коммитятся (DEVELOPMENT_PLAN §2 «Секреты»).
# Все поля platform/settings.py; тест проверяет, что список полный.

# Приложение: окружение dev|test|stage|production, уровень логов, JSON-логи, релиз
APP_ENV=
# Имя продукта в текстах сервера ({{appName}} правовых документов); пусто — «Соседи»
APP_NAME=
APP_LOG_LEVEL=
APP_LOG_JSON=
APP_RELEASE=
APP_HEARTBEAT_URL=
APP_WEB_HOST=
APP_WEB_PORT=
# JSON-списки CIDR: свои прокси (их X-Forwarded-* принимаем; пусто — loopback и частные сети)
# и край Cloudflare (адрес клиента — из CF-Connecting-IP; пусто — список cloudflare.com/ips)
APP_TRUSTED_PROXIES=
APP_CLOUDFLARE_IPS=
APP_API_PUBLIC_URL=
# JSON, например {"tma":"1.0.0"}; пусто — без проверки версий клиентов (426)
APP_MIN_CLIENT_VERSIONS=
# Ключ HMAC хэшей удалённых аккаунтов (антифрод 12 мес); stage и прод — обязательно, не менять
APP_HASH_KEY=

# PostgreSQL: DSN роли app (обязателен), DSN роли migrator для Alembic, пул — make secrets-dev
DB_DSN=
DB_MIGRATOR_DSN=
# DSN роли readonly для отчётов ликвидности (6.6, cli beta-report); пусто — роль app, только чтение
DB_READONLY_DSN=
DB_POOL_SIZE=
DB_POOL_MAX_OVERFLOW=
DB_ECHO=

# Valkey (обязателен) — make secrets-dev
VALKEY_URL=

# Telegram: токен и @username бота (обязательны; dev-бот — K4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Приём апдейтов: polling (dev, по умолчанию) или webhook (stage, prod — задаёт Kamal; нужен
# секрет 32–256 символов [A-Za-z0-9_-] от make gen-secret и https:// в APP_API_PUBLIC_URL)
TELEGRAM_UPDATES=
# Схема и хост процесса bot для webhook, без пути (stage — https://stage-bot.<домен>); пусто —
# APP_API_PUBLIC_URL
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=
TELEGRAM_USE_TEST_ENVIRONMENT=
# Аккаунт поддержки для /help (K23, Q25), без @; пусто — «контакт появится скоро»
TELEGRAM_SUPPORT_USERNAME=
# Закрытый чат модераторов (K29, шаг 2.5b): id группы с ботом, обычно -100…; пусто — карточек
# кейсов нет, решения — командами cli moderation-decide / dispute-resolve. Туда же — алерт
# падения response rate@4h (6.6); без чата он уходит в лог и Sentry
TELEGRAM_MODERATORS_CHAT_ID=
# Только нагрузочный прогон на stage (8.3, docs/loadtest/README.md): true — уведомления не уходят
# в Telegram, а ждут тот же лимитер и латентность Bot API. На проде процесс с ним не стартует
TELEGRAM_FAKE_SENDER=

# JWT: ключи генерирует cli jwt-keys (шаг 0.14)
JWT_ISSUER=
JWT_ACCESS_TTL_SECONDS=
JWT_REFRESH_TTL_DAYS=
JWT_REFRESH_TTL_DAYS_TMA=
# Ключи подписи access JWT: make cli ARGS=jwt-keys (повторно — с --rotate)
JWT_KEYS=

# S3 / R2: локально Garage — make garage-init
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_INCOMING=
S3_BUCKET_MEDIA=
S3_BUCKET_PRIVATE=
S3_PUBLIC_BASE_URL=
S3_PUBLIC_ENDPOINT_URL=

# Sentry: без DSN выключен (K20)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=

# AI-модерация (K25, K26, шаг 2.4): без ключей — заглушки. Модели по умолчанию —
# omni-moderation-latest и claude-haiku-4-5 (ADR-0016); таймаут проверки — 10 с
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_MODERATION_MODEL=
AI_CLASSIFIER_MODEL=
AI_TIMEOUT_SECONDS=

# Аналитика PostHog (K32, шаг 1.7)
ANALYTICS_POSTHOG_API_KEY=
ANALYTICS_POSTHOG_HOST=
# Отчёт и алерт ликвидности (6.6): понедельник недели 1 беты (по умолчанию 2027-01-25),
# порог response rate@4h (по умолчанию 0.70) и минимум заявок для алерта (по умолчанию 10)
ANALYTICS_BETA_START=
ANALYTICS_RESPONSE_RATE_ALERT_THRESHOLD=
ANALYTICS_RESPONSE_RATE_ALERT_MIN_JOBS=

# Правовые документы (backend/content/legal, шаг 1.5a): оператор данных и почта поддержки —
# подстановки {{OPERATOR_NAME}} и {{CONTACT_EMAIL}}. Пусто — заглушка TODO (решение владельца,
# K22); на проде (APP_ENV=production) процесс с заглушкой не стартует
LEGAL_OPERATOR_NAME=
LEGAL_CONTACT_EMAIL=
