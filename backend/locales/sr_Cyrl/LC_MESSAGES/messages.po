msgid "bot.profile.name"
msgstr "Соседи"

msgid "bot.profile.description"
msgstr "„Соседи“ — мајстори и помоћ у близини: поправке, лепота, чишћење, селидбе, часови. Опишите задатак — извођачи ће се јавити са ценом. Или изаберите стручњака по утисцима.\n\nПритисните дугме испод да почнете."

msgid "bot.profile.short_description"
msgstr "Мајстори и помоћ у близини: поправке, лепота, чишћење, селидбе, часови."

