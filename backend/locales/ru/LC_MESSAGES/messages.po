msgid "bot.start.welcome"
msgstr "Здравствуйте, {name}! Это «Соседи» — здесь находят мастеров и помощь рядом: ремонт, красота, уборка, переезды, уроки. Нажмите «Открыть», чтобы начать."

msgid "bot.start.welcome_back"
msgstr "С возвращением, {name}! Откройте «Соседи» кнопкой ниже."

msgid "bot.start.open"
msgstr "Открыть «Соседи»"

msgid "bot.menu.open"
msgstr "Открыть"

msgid "bot.app.text"
msgstr "Откройте «Соседи» кнопкой ниже или кнопкой меню слева от поля ввода."

msgid "bot.help.text"
msgstr "<b>Как это работает</b>\n• Опишите задачу — мастера рядом откликнутся с ценой. Или выберите специалиста по отзывам.\n• Договаривайтесь в чате «Соседей»: контакты — после договорённости.\n• Оплата — напрямую исполнителю, после работы. «Соседи» деньги не принимают.\n\n<b>Безопасность</b>\n• Не вносите предоплату незнакомым и никому не сообщайте коды из СМС.\n• Подозрительный профиль или сообщение — пожалуйтесь прямо в приложении.\n\n/terms — правила площадки\n/privacy — политика конфиденциальности\n/language — язык"

msgid "bot.help.support"
msgstr "Вопрос или проблема? Напишите в поддержку — ответим."

msgid "bot.help.support_button"
msgstr "Написать в поддержку"

msgid "bot.help.support_soon"
msgstr "Контакт поддержки скоро появится здесь."

msgid "bot.legal.text"
msgstr "<b>{title}</b>\nРедакция {version} от {date}.\n\nПолный текст — по кнопке ниже."

msgid "bot.legal.text_no_version"
msgstr "<b>{title}</b>\n\nПолный текст — по кнопке ниже."

