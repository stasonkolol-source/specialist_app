msgstr "Готово: язык — {language}."

msgid "bot.language.need_start"
msgstr "Сначала нажмите /start."

msgid "bot.fallback"
msgstr "Я понимаю команды:\n/app — открыть приложение\n/help — помощь и поддержка\n/language — язык"

