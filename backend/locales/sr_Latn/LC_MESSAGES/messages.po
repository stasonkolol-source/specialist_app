msgid "bot.start.welcome"
msgstr "Zdravo, {name}! Ovo su „Sosedi“ — ovde se nalaze majstori i pomoć u blizini: popravke, lepota, čišćenje, selidbe, časovi. Pritisnite „Otvori“ da počnete."

msgid "bot.start.welcome_back"
msgstr "Dobro došli ponovo, {name}! Otvorite aplikaciju „Sosedi“ dugmetom ispod."

msgid "bot.start.open"
msgstr "Otvori aplikaciju „Sosedi“"

msgid "bot.menu.open"
msgstr "Otvori"

msgid "bot.app.text"
msgstr "Otvorite aplikaciju „Sosedi“ dugmetom ispod ili dugmetom „Otvori“ levo od polja za poruku."

msgid "bot.help.text"
msgstr "<b>Kako funkcioniše</b>\n• Opišite zadatak — majstori u blizini će se javiti sa cenom. Ili izaberite stručnjaka po utiscima.\n• Dogovarajte se u četu aplikacije „Sosedi“: kontakti — nakon dogovora.\n• Plaćanje — direktno izvođaču, posle posla. „Sosedi“ ne primaju novac.\n\n<b>Bezbednost</b>\n• Ne plaćajte unapred nepoznatim ljudima i nikome ne govorite kodove iz SMS poruka.\n• Sumnjiv profil ili poruka — prijavite direktno u aplikaciji.\n\n/terms — pravila platforme\n/privacy — politika privatnosti\n/language — jezik"

msgid "bot.help.support"
msgstr "Pitanje ili problem? Pišite podršci — odgovorićemo."

msgid "bot.help.support_button"
msgstr "Pišite podršci"

msgid "bot.help.support_soon"
msgstr "Kontakt podrške uskoro će biti ovde."

