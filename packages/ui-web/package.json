{
  "name": "@sosed/ui-web",
  "version": "0.0.0",
  "private": true,
  "description": "Компоненты веба на токенах design-tokens (1:1 по классам ui.css) и галерея",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "gallery": "vite --config gallery/vite.config.ts",
    "gallery:build": "vite build --config gallery/vite.config.ts",
    "e2e:build": "vite build --config gallery/vite.config.ts",
    "e2e": "playwright test",
    "icons": "node scripts/icons.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@sosed/design-tokens": "workspace:*",
    "thumbhash": "0.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@sosed/config": "workspace:*",
    "@sosed/i18n": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "jsdom": "29.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
