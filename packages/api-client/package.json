    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@sosed/config": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.11.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "orval": "8.37.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
