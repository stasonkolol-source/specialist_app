{
  "name": "@sosed/api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Клиент API: хуки TanStack Query, Zod-схемы и MSW-моки из OpenAPI (orval, шаг 0.20)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./mocks": "./src/mocks.ts",
